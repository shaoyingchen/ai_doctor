# ============================================================
# AI Doctor 后端环境变量样例
# 复制本文件为 .env 并填入真实值即可生效（app.py 启动时自动加载）
# 所有 LLM / Embedding 接入均走 OpenAI 兼容协议（base_url 可配），
# 兼容智谱 GLM / DeepSeek / OpenAI 及任何 OpenAI 兼容网关。
# 不配置 API Key 时服务仍可启动：embedding 降级为确定性 hash 假向量，
# QA 生成降级为模板结果（日志会有 warning 提示）。
# ============================================================

# ---------------- LLM（问答生成 / 问题泛化 / 后续 RAG 对话） ----------------

# OpenAI 兼容接口地址（不含 /chat/completions 后缀）
# 智谱 GLM:  https://open.bigmodel.cn/api/paas/v4
# DeepSeek:  https://api.deepseek.com/v1
# OpenAI:    https://api.openai.com/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# API Key（必填，不填则 LLM 相关功能走降级逻辑）
LLM_API_KEY=

# 对话模型名
# 智谱: glm-4-flash（免费）/ glm-4-air / glm-4-plus
# DeepSeek: deepseek-chat
# OpenAI: gpt-4o-mini
LLM_MODEL=glm-4-flash

# 请求超时时间（秒）
LLM_TIMEOUT=60

# ---------------- Embedding（向量化，供 Qdrant 检索） ----------------

# 不配置时默认复用 LLM_BASE_URL / LLM_API_KEY
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Embedding 模型名
# 智谱: embedding-3 / embedding-2
# DeepSeek: 暂无 embedding 服务，需指向其它兼容服务
# OpenAI: text-embedding-3-small / text-embedding-3-large
EMBEDDING_MODEL=embedding-3

# 向量维度，必须与 Qdrant collection 一致（不一致时会告警并重建 collection）
# 智谱 embedding-3: 1024；OpenAI text-embedding-3-small: 1536
EMBEDDING_DIM=1024

# ---------------- CORS ----------------

# 允许的前端来源，逗号分隔
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
