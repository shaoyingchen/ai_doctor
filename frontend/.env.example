# Environment Variables for AI Doctor Frontend

# API Configuration
VITE_API_BASE_URL=http://localhost:8000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8000
VITE_WS_RECONNECT_INTERVAL=3000
VITE_WS_MAX_RECONNECT_ATTEMPTS=5

# Polling Configuration (fallback when WebSocket unavailable)
VITE_POLLING_INTERVAL=5000
VITE_POLLING_ENABLED=true

# Performance Configuration
VITE_ENABLE_VIRTUAL_SCROLL=true
VITE_VIRTUAL_SCROLL_ITEM_HEIGHT=80
VITE_VIRTUAL_SCROLL_OVERSCAN=5

# Feature Flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_BATCH_QUERY=true

# Debug
VITE_DEBUG_MODE=false
